<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pos-v2.memory-graphiti</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/lukeivers/ivers-corp-pos-v2/memory-system/.venv/bin/python</string>
        <string>-m</string>
        <string>src.service</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/lukeivers/ivers-corp-pos-v2/memory-system</string>

    <!-- Auto-start at login. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Restart on crash. The service is the system of record for the
         memory store; if it dies it should come back. KeepAlive without
         conditions can busy-loop on a fundamentally-broken state, but
         for a prototype that's the right shape — we want loud failure,
         not silent absence. -->
    <key>KeepAlive</key>
    <true/>

    <!-- Defer restart attempts so a hard crash doesn't pin a CPU. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/lukeivers/ivers-corp-pos-v2/memory-system/data/graphiti-service.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/lukeivers/ivers-corp-pos-v2/memory-system/data/graphiti-service.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
</dict>
</plist>
