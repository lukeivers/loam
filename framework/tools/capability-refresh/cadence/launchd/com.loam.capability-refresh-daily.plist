<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- capability-refresh launchd FALLBACK binding (high-velocity / daily).
     The PRIMARY cadence binding is the cloud routine (routine-spec.md);
     this plist ships so a workspace without cloud routines still gets
     the unattended cadence (D-CUR.2 fallback). Activation is OWNER-GATED:
     see ACTIVATION.md. Requires the machine awake at fire time. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.loam.capability-refresh-daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd /Users/lukeivers/loam &amp;&amp; ./framework/tools/capability-refresh/scripts/run-cadence.sh high-velocity</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/com.loam.capability-refresh-daily.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.loam.capability-refresh-daily.log</string>
</dict>
</plist>
