# pOS v2 memory-system prototyping — environment template.
# Copy to .env and fill values. Never commit .env.

# Anthropic API key for Claude (LLM-driven extraction, contradiction
# resolution, summarisation, reranking). The brief constraint is
# Max-subscription-first; in practice graphiti-core requires SDK access,
# which uses a standard API key. Pay attention to the per-prompt token
# tracker in D4 — extraction cost is what the Max budget conversation
# is actually about.
ANTHROPIC_API_KEY=sk-ant-...

# Anthropic Claude model to use for extraction-class prompts.
# claude-haiku-4-5 = cheapest / fastest current haiku
# claude-sonnet-4-5 = recommended balance
# claude-opus-4-5 = highest quality, most expensive
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_SMALL_MODEL=claude-haiku-4-5

# Ollama OpenAI-compatible endpoint (default for local install).
OLLAMA_BASE_URL=http://localhost:11434/v1
# Embedding model in Ollama. Switched per D3 evaluation.
OLLAMA_EMBED_MODEL=nomic-embed-text
# Ollama doesn't validate keys, but the OpenAI SDK requires one.
OLLAMA_API_KEY=ollama

# Kuzu DB directory (single-file-ish embedded graph store).
KUZU_DB_PATH=./data/kuzu_db

# FastAPI service config.
GRAPHITI_SERVICE_HOST=127.0.0.1
GRAPHITI_SERVICE_PORT=9876
