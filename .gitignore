orchestrator/data/

# Editor
.vscode/
.idea/
*.swp

# OS
.DS_Store

# Scratch / agent working files
.scratch/

# Workspace-local pos-v2 sentinel directory (first-run state, active-
# scope sentinel, session-state sentinels). Per the structural-
# enforcement A1 substrate amendment (AC.SE.8). The directory holds
# runtime-written files only and must never be tracked.
.pos/

# Workspace-local Claude Code MCP-server registration (amendment #47).
# `.mcp.json` is per-workspace state scaffolded by workspace-bootstrap's
# first-run scaffold (memory-graphiti server registration with the
# per-workspace memory-sidecar port from `memory.yaml`). It is regenerated
# on first-run for every clone and must never be committed.
.mcp.json
data/
workspace/
personas/

# odd-extractor per-extraction state (v0.2.5 corrective C6 F-DESIGN-3
# fix). Pre-C6 default workspace-root was cwd; running smoke / dev
# invocations of `loam odd-extract` from inside pos-v2 would write to
# `<pos-v2>/.loam/extractions/`. C6 changed the default to the target
# repo, but explicit `--workspace-root <pos-v2>` still lands artefacts
# here. Either way, the per-extraction state must never be committed.
.loam/

# loam-init scaffold output (workspace-state, not source — auto-created by plugin install/init flow)
.claude/
